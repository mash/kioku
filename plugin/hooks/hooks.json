{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [{"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/kioku.sh\" start", "timeout": 120}]
      },
      {
        "matcher": "compact",
        "hooks": [{"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/kioku.sh\" compact", "timeout": 120}]
      }
    ]
  }
}
