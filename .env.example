# Export these variables before starting kiokud, or use docker --env-file.
KIOKU_ADDR=0.0.0.0:8080
KIOKU_BASE_URL=https://kioku.example.com
KIOKU_DATA=/data
# Optional override (base64-encoded 32-byte key, e.g. openssl rand -base64 32).
# When unset, persist/reuse KIOKU_DATA/encryption.key (0600); back up this file.
KIOKU_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Object store: local (default when unset) or s3.
KIOKU_STORAGE=local
# Required only with KIOKU_STORAGE=s3; leave empty for local.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional temporary-credential token.
S3_SESSION_TOKEN=
# Optional managed generation: configure these three together, or leave all empty.
# To require this runner explicitly, set KIOKU_RUNNER=claudemanaged.
ANTHROPIC_API_KEY=
KIOKU_MA_AGENT_ID=
KIOKU_MA_ENVIRONMENT_ID=
KIOKU_MA_AGENT_VERSION=0
KIOKU_MA_BASE_URL=https://api.anthropic.com
# Empty disables webhooks; the 30-second reconciler remains active.
ANTHROPIC_WEBHOOK_SIGNING_KEY=

# Optional Prometheus endpoint bearer token; empty disables access.
KIOKU_METRICS_TOKEN=

