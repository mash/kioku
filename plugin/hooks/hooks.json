{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|fork",
        "hooks": [{"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/kioku.sh\" start", "timeout": 120}]
      },
      {
        "matcher": "compact|resume",
        "hooks": [{"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/kioku.sh\" compact", "timeout": 120}]
      }
    ],
    "PreCompact": [
      {
        "hooks": [{"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/kioku.sh\" precompact", "timeout": 10}]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/kioku.sh\" capture", "timeout": 10}]
      }
    ]
  }
}
